// Skema database Lembur QR.
// DATABASE_URL = connection string Neon yang "pooled" (ada -pooler di host)
// DIRECT_URL   = connection string Neon yang "direct", dipakai Prisma untuk migrasi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PETUGAS
}

enum JenisHari {
  KERJA
  LIBUR
}

enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  passwordHash String
  nama         String
  role         Role         @default(PETUGAS)
  area         String       @default("Semua")
  aktif        Boolean      @default(true)
  lastLogin    DateTime?
  createdAt    DateTime     @default(now())
  tapDicatat   Lembur[]
  tapDitolak   TapDitolak[]
  pengajuanDiproses PengajuanTap[] @relation("PengajuanDiproses")
  splDibuat    Spl[]
  sesiQr       SesiLembur[]
  wajahDiproses WajahKaryawan[]
}

model Karyawan {
  id              Int           @id @default(autoincrement())
  nik             String        @unique
  nama            String
  departemen      String
  jabatan         String        @default("Operator")
  /// Upah pokok + tunjangan tetap per bulan, dalam rupiah
  upahBulanan     Int
  /// Token acak yang dicetak sebagai QR di ID card (bukan NIK)
  qrToken         String        @unique
  aktif           Boolean       @default(true)
  perluCetakUlang Boolean       @default(false)
  /// Portal karyawan: login NIK + sandi. Kosong = portal belum diaktifkan admin
  sandiHash       String?
  /// true = sandi masih sandi awal dari admin, wajib diganti saat login
  wajibGantiSandi Boolean       @default(true)
  /// Token login yang dibuat sebelum waktu ini ditolak (setelah ganti/reset sandi)
  sandiDiubah     DateTime?
  loginTerakhir   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lembur          Lembur[]
  tokenLama       QrTokenLama[]
  tapDitolak      TapDitolak[]
  pengajuan       PengajuanTap[]
  langganan       LanggananPush[]
  notifikasi      Notifikasi[]
  sesiLembur      SesiLembur?
  wajah           WajahKaryawan?
}

/// Token QR yang sudah diganti. Disimpan supaya scanner bisa bilang "kartu lama".
model QrTokenLama {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  karyawanId Int
  karyawan   Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  diganti    DateTime @default(now())
}

model Lembur {
  id         Int       @id @default(autoincrement())
  karyawanId Int
  karyawan   Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  /// Tanggal kerja menurut zona waktu Asia/Jakarta
  tanggal    DateTime  @db.Date
  waktuTap   DateTime
  jenisHari  JenisHari
  jamHitung  Float
  /// Disimpan per tap supaya kenaikan gaji tidak mengubah data lama
  upahSejam  Int
  nominal    Int
  /// Untuk tap dari scan: petugas yang men-scan. Untuk tap manual: admin yang menambahkan
  petugasId  Int
  petugas    User      @relation(fields: [petugasId], references: [id])
  /// true = ditambahkan admin karena tap terlewat (bukan dari scan QR)
  manual     Boolean   @default(false)
  /// Alasan tap manual, wajib diisi admin (misalnya nomor SPL)
  alasan     String?
  createdAt  DateTime  @default(now())
  /// Ada isinya kalau tap ini berasal dari pengajuan karyawan yang disetujui
  pengajuan  PengajuanTap?
  /// Ada isinya kalau tap dicatat lewat input lembur massal (centang daftar / foto SPL)
  splId      Int?
  spl        Spl?      @relation(fields: [splId], references: [id], onDelete: SetNull)
  /// TETAP = 1 tap, jam hitung tetap (5,5 / 14). AKTUAL = dari jam mulai–selesai (PP 35/2021)
  metode     String    @default("TETAP")
  /// Jam mulai & selesai lembur (metode AKTUAL)
  mulai      DateTime?
  selesai    DateTime?
  /// Menit lembur bersih setelah dipotong istirahat & dibulatkan
  menitLembur Int?
  /// Rincian tarif, mis. [{"jam":1,"kali":1.5},{"jam":2,"kali":2}] + aturan yang dipakai
  rincianHitung Json?
  /// Sumber tap: KARTU (scan petugas), MANDIRI (QR mandiri + wajah), MASSAL, MANUAL
  sumber     String?
  /// Jarak wajah saat tap mandiri (makin kecil makin mirip)
  jarakWajah Float?

  /// Satu karyawan hanya boleh satu tap per hari
  @@unique([karyawanId, tanggal])
  @@index([tanggal])
}

model HariLibur {
  tanggal    DateTime @id @db.Date
  keterangan String
}

model TapDitolak {
  id         Int       @id @default(autoincrement())
  tanggal    DateTime  @db.Date
  waktu      DateTime  @default(now())
  karyawanId Int?
  karyawan   Karyawan? @relation(fields: [karyawanId], references: [id], onDelete: SetNull)
  alasan     String
  petugasId  Int
  petugas    User      @relation(fields: [petugasId], references: [id])

  @@index([tanggal])
}

/// Karyawan melapor lembur yang lupa di-tap. Admin menyetujui → jadi tap manual.
model PengajuanTap {
  id             Int             @id @default(autoincrement())
  karyawanId     Int
  karyawan       Karyawan        @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  tanggal        DateTime        @db.Date
  /// Jam selesai lembur menurut karyawan, HH:mm WIB
  jam            String
  alasan         String
  status         StatusPengajuan @default(MENUNGGU)
  catatanAdmin   String?
  diprosesOlehId Int?
  diprosesOleh   User?           @relation("PengajuanDiproses", fields: [diprosesOlehId], references: [id], onDelete: SetNull)
  diprosesPada   DateTime?
  lemburId       Int?            @unique
  lembur         Lembur?         @relation(fields: [lemburId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([status])
  @@index([karyawanId, tanggal])
}

/// Perangkat karyawan yang mau menerima notifikasi.
/// WEB = Web Push (PWA/browser), FCM = aplikasi Android/iOS lewat Firebase.
model LanggananPush {
  id              Int       @id @default(autoincrement())
  karyawanId      Int
  karyawan        Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  jenis           String
  /// Endpoint Web Push atau token FCM
  endpoint        String    @unique
  p256dh          String?
  auth            String?
  perangkat       String?
  createdAt       DateTime  @default(now())
  terakhirDipakai DateTime?

  @@index([karyawanId])
}

/// Kotak masuk notifikasi karyawan (ikon lonceng di portal). Disimpan walau push mati.
model Notifikasi {
  id         Int      @id @default(autoincrement())
  karyawanId Int
  karyawan   Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  judul      String
  isi        String
  url        String   @default("/portal")
  dibaca     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([karyawanId, createdAt])
}

/// Surat Perintah Lembur yang dipakai untuk input lembur massal.
model Spl {
  id          Int      @id @default(autoincrement())
  nomor       String?
  tanggal     DateTime @db.Date
  jamSelesai  String
  alasan      String
  /// "CENTANG" (pilih dari daftar) atau "FOTO" (dibaca dari foto SPL)
  sumber      String   @default("CENTANG")
  /// Foto SPL sebagai bukti. Disimpan di Neon Object Storage (fotoKey);
  /// kolom foto hanya dipakai kalau object storage belum diatur.
  foto        Bytes?
  fotoMime    String?
  fotoKey     String?
  fotoUkuran  Int?
  /// Diisi saat foto dihapus karena lewat masa simpan (data lembur tetap ada)
  fotoDihapus DateTime?
  teksOcr     String?
  dibuatOlehId Int
  dibuatOleh  User     @relation(fields: [dibuatOlehId], references: [id])
  createdAt   DateTime @default(now())
  lembur      Lembur[]

  @@index([tanggal])
  @@index([createdAt])
}

/// Pemakaian pembaca SPL (Azure) per bulan, supaya tidak melewati kuota gratis.
model PemakaianOcr {
  bulan  String @id // YYYY-MM
  jumlah Int    @default(0)
}

/// Tap in mandiri yang belum di-tap out. Satu karyawan paling banyak satu sesi terbuka.
model SesiLembur {
  id          Int      @id @default(autoincrement())
  karyawanId  Int      @unique
  karyawan    Karyawan @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  /// Tanggal lembur = tanggal tap in (WIB)
  tanggal     DateTime @db.Date
  mulai       DateTime
  /// Petugas yang QR-nya dipindai saat tap in
  petugasId   Int
  petugas     User     @relation(fields: [petugasId], references: [id])
  jarakWajah  Float?
  createdAt   DateTime @default(now())
}

/// Wajah acuan karyawan untuk verifikasi tap mandiri (data pribadi spesifik, UU PDP).
/// Disimpan hanya vektor wajah + foto kecil untuk diperiksa admin.
model WajahKaryawan {
  karyawanId     Int       @id
  karyawan       Karyawan  @relation(fields: [karyawanId], references: [id], onDelete: Cascade)
  /// 128 angka dari model pengenal wajah
  vektor         Json
  foto           Bytes
  fotoMime       String    @default("image/webp")
  /// MENUNGGU, DISETUJUI, DITOLAK
  status         String    @default("MENUNGGU")
  /// Waktu karyawan menyetujui pemrosesan data wajah
  persetujuan    DateTime
  catatan        String?
  diprosesOlehId Int?
  diprosesOleh   User?     @relation(fields: [diprosesOlehId], references: [id], onDelete: SetNull)
  diprosesPada   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

/// Pengaturan yang bisa diubah admin, mis. kunci "aturanLembur".
model Pengaturan {
  kunci  String   @id
  nilai  Json
  diubah DateTime @updatedAt
}
