# Salin jadi .env untuk development lokal. Di Render, isi di menu Environment.

# Neon > Connection Details. Pakai yang "Pooled connection" (host ada -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon > Connection Details, matikan "Pooled connection". Dipakai untuk migrasi
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Rahasia untuk tanda tangan JWT, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="12h"

# Domain frontend yang boleh memanggil API, pisahkan dengan koma
CORS_ORIGIN="http://localhost:5173"

# Aplikasi Android/iOS/desktop otomatis diizinkan. Isi false kalau hanya pakai versi web
IZINKAN_APLIKASI_NATIVE="true"

# true = boleh kirim waktu simulasi saat scan (untuk demo/pengujian). Produksi: false
IZINKAN_WAKTU_SIMULASI="false"

# Dipakai saat npm run db:seed
SEED_ADMIN_PASSWORD="ganti-sandi-admin"
SEED_PETUGAS_PASSWORD="ganti-sandi-petugas"
SEED_CONTOH_KARYAWAN="true"

PORT=4000

# ---------- Portal karyawan ----------
# Lama login karyawan sebelum harus masuk lagi
JWT_KARYAWAN_EXPIRES_IN="30d"
# Nama perusahaan di slip lembur PDF
NAMA_PERUSAHAAN="PT Nama Perusahaan"

# ---------- Notifikasi ----------
# Web Push (PWA/browser). Buat sekali: npm run vapid, lalu salin dua kuncinya ke sini
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hrd@perusahaan.co.id"
# Opsional, untuk notifikasi di aplikasi Android/iOS: isi JSON service account Firebase
# (boleh di-base64: base64 -w0 service-account.json)
FIREBASE_SERVICE_ACCOUNT=""

# Periode lembur: 21 s/d 20 bulan berikutnya. Isi tanggal tutup lain kalau berbeda (1–28)
TANGGAL_TUTUP_PERIODE="20"

# ---------- Foto bukti SPL: Neon Object Storage ----------
# Neon Console → Connect → tab Storage (atau: neon env pull). Kosong = foto disimpan di database.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="foto-spl"
# Foto dihapus otomatis setelah sekian bulan (data lembur tetap ada). 0 = simpan selamanya
FOTO_SPL_SIMPAN_BULAN="13"

# ---------- Pembaca SPL tulisan tangan: Azure AI Vision (Read) ----------
# Kosong = pakai pembaca lokal (tesseract) di perangkat. Lihat README "Pembaca SPL Azure".
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""
# Berhenti memanggil Azure setelah sekian gambar per bulan (gratis F0 = 5000)
AZURE_VISION_BATAS_BULANAN="4500"
