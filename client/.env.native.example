# Salin jadi .env.native sebelum build aplikasi Android/iOS/desktop.
# Wajib alamat lengkap backend Render (https), karena aplikasi native tidak punya domain sendiri.
VITE_API_URL=https://lemburin-api.onrender.com

# true = aktifkan notifikasi di aplikasi Android/iOS lewat Firebase.
# Hanya isi true kalau google-services.json (Android) / GoogleService-Info.plist (iOS)
# sudah dipasang, karena tanpa itu aplikasi Android bisa crash saat mendaftar notifikasi.
VITE_FCM=false
