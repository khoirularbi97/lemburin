{
  "name": "lemburin-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "vite build --mode native",
    "cap:sync": "npm run build:native && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "ikon:native": "capacitor-assets generate --android --ios --iconBackgroundColor '#12152B' --iconBackgroundColorDark '#12152B' --splashBackgroundColor '#12152B' --splashBackgroundColorDark '#12152B'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "html5-qrcode": "2.3.8",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1"
  }
}
